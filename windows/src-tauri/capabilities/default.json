{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Jendela utama Djie Cast",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }, { "path": "$TEMP/**" }, { "path": "$APPCACHE/**" }]
    }
  ]
}
