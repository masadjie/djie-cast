{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Djie Cast",
  "version": "1.0.0",
  "identifier": "id.djie.cast",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Djie Cast",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Adjie Kurniawan",
    "copyright": "© 2026 Adjie Kurniawan",
    "category": "Utility",
    "shortDescription": "Android mirroring untuk Windows",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/scrcpy/*": "scrcpy/" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Indonesian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
